PROJECT_NAME      = "Samurai"
XML_OUTPUT        = xml
INPUT             = ../include
GENERATE_LATEX    = NO
GENERATE_MAN      = NO
GENERATE_RTF      = NO
CASE_SENSE_NAMES  = NO
GENERATE_HTML     = NO
GENERATE_XML      = YES
RECURSIVE         = YES
QUIET             = YES
JAVADOC_AUTOBRIEF = YES
WARN_IF_UNDOCUMENTED = NO
MACRO_EXPANSION = YES
# Expand SAMURAI_INLINE to nothing so that signatures do not depend on the
# inlining options (see include/samurai/samurai_config.hpp).
PREDEFINED = SAMURAI_INLINE=
# Implementation details are not part of the public API.
EXCLUDE_SYMBOLS = detail *::detail
